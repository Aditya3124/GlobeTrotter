generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String // Hashed for custom auth
  firstName    String
  lastName     String
  phone        String?
  city         String?
  country      String?
  profilePhoto String?
  bio          String?
  trips        Trip[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Trip {
  id          String   @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  coverPhoto  String?
  budget      Json?
  isPublic    Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stops       Stop[]
  activities  Activity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Stop {
  id         String     @id @default(uuid())
  city       String
  country    String
  startDate  DateTime
  endDate    DateTime
  order      Int
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]
}

model Activity {
  id          String   @id @default(uuid())
  name        String
  description String?
  date        DateTime?
  duration    String?
  cost        Float    @default(0)
  type        String? // e.g., Sightseeing, Food, etc.
  order       Int      @default(0)
  cityId      String
  stop        Stop     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// --- Global Catalog Data (From CSVs) ---

model City {
  id         String   @id @default(uuid())
  city       String
  latitude   Float
  longitude  Float
  country    String
  population BigInt?
  
  // Relations
  costOfLiving CostOfLiving?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DestinationActivity {
  id              String   @id @default(uuid())
  destinationName String
  country         String
  continent       String
  category        String
  cost            Float
  bestSeason      String
  rating          Float

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CostOfLiving {
  id                       String   @id @default(uuid())
  rank                     Int
  city                     String
  country                  String
  region                   String
  costIndex                Float
  rentIndex                Float
  groceriesIndex           Float
  mealCostIndex            Float
  localPurchasingPowerIndex Float
  populationCityMillions   Float?
  costCrisisTier           Int
  costCategory             String

  // Relation to City model
  cityRefId                String?  @unique
  cityRef                  City?    @relation(fields: [cityRefId], references: [id], onDelete: Cascade)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
